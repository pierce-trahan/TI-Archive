{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js server.cjs",
    "lint": "tsc --noEmit",
    "ingest:matches": "tsx scripts/ingest-matches.ts",
    "build:playermap": "tsx scripts/build-player-map.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "ingest:liquipedia": "tsx scripts/ingest-liquipedia.ts",
    "propose:identities": "tsx scripts/propose-identities.ts",
    "review:identities": "tsx scripts/review-identities.ts",
    "promote:identities": "tsx scripts/promote-identities.ts",
    "build:placements": "tsx scripts/build-placements.ts",
    "compute:stats": "tsx scripts/compute-stats.ts",
    "ingest:heroes": "tsx scripts/ingest-hero-pool.ts",
    "research:reddit": "tsx --env-file-if-exists=.env scripts/research-reddit.ts",
    "research:wayback": "tsx scripts/research-wayback.ts",
    "research:gosugamers": "tsx scripts/research-gosugamers.ts",
    "research:liquipedia": "tsx scripts/research-liquipedia-tier1.ts",
    "fetch:logos": "tsx scripts/fetch-team-logos.ts",
    "build:chart": "tsx scripts/build-season-chart.ts",
    "verify:datdota": "tsx scripts/verify-datdota.ts",
    "apply:datdota": "tsx scripts/apply-datdota.ts",
    "ingest:playerids": "tsx scripts/ingest-player-ids.ts",
    "verify:playerids": "tsx scripts/verify-playerids.ts",
    "build:standings": "tsx scripts/build-group-standings.ts",
    "verify:names": "tsx scripts/verify-computed-names.ts",
    "fetch:photos": "tsx scripts/fetch-player-photos.ts",
    "build:rosters": "tsx scripts/build-rosters-section.ts",
    "ingest:prizes": "tsx scripts/ingest-season-prizes.ts",
    "ingest:results": "tsx scripts/ingest-team-results.ts",
    "build:bracket": "tsx scripts/build-bracket.ts",
    "compute:items": "tsx scripts/compute-item-meta.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "undici": "^8.10.0",
    "vite": "^6.2.3"
  }
}
