# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Only the research scripts need any of this. The archive itself ships with no
# keys and makes no network calls at runtime.

# ---- Reddit ----------------------------------------------------------------
# Needed by: npm run research:reddit
#
# Reddit blocks Anthropic's crawler by policy, so reaction threads can only be
# collected from your own machine with your own credentials.
#
# Create a "script" app at https://www.reddit.com/prefs/apps
#   - name:         anything, e.g. ti-archive-research
#   - type:         script
#   - redirect uri: http://localhost:8080  (unused, but required)
#
# The client id is the string under the app name; the secret is labelled.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
